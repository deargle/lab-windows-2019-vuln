<Configuration Product="ProPlus">
  <!--
    Office Professional Plus 2010 silent-install answer file for the
    malicious-macro lab (lab_social_engineering.md, Part 4).

    Key choices:
      * Display Level="none" + AcceptEula="yes"  -> fully silent, no clicks.
      * NO <PIDKEY> element on purpose. With no product key, Office 2010
        installs into its built-in ~30-day grace period and runs fully
        functional with NO Microsoft account and NO activation. The grace
        clock is reset later with OSPPREARM (office-rearm.ps1). Adding a MAK
        here would make it non-expiring but is NOT required for the lab.
      * Word only. Every other app is set Absent to keep the install fast and
        the box small (the lab only uses Word). Getting a feature id slightly
        wrong only makes the footprint bigger, never breaks the install.
  -->
  <Display Level="none" CompletionNotice="no" SuppressModal="yes" AcceptEula="yes" />
  <Logging Type="standard" Path="%temp%" Template="Office2010Setup(*).txt" />

  <OptionState Id="WORDFiles"      State="Local"  Children="force" />
  <OptionState Id="EXCELFiles"     State="Absent" Children="force" />
  <OptionState Id="OUTLOOKFiles"   State="Absent" Children="force" />
  <OptionState Id="PPTFiles"       State="Absent" Children="force" />
  <OptionState Id="ACCESSFiles"    State="Absent" Children="force" />
  <OptionState Id="ONENOTEFiles"   State="Absent" Children="force" />
  <OptionState Id="PubPrimary"     State="Absent" Children="force" />
  <OptionState Id="InfoPathFiles"  State="Absent" Children="force" />
  <OptionState Id="GrooveFiles"    State="Absent" Children="force" />
  <OptionState Id="SHAREDFiles"    State="Local" />
  <OptionState Id="TOOLSFiles"     State="Local" />

  <Setting Id="SETUP_REBOOT" Value="Never" />
</Configuration>
